function plotRobot(X,p)

params = p.params;

q = X(1:3);
% p1 = [0 0]';
p2 = fcn_p2(q,params);
p3 = fcn_p3(q,params);
p4 = fcn_p4(q,params);

chain = [p2 p3 p4];


plot(chain(1,:),chain(2,:),'color','white','linewidth',4);
hold on
plot(chain(1,:),chain(2,:),'ocyan','LineWidth',4);
% plot(0,0,'or','LineWidth',4);
yline(0,'--white')
grid on
axis equal
axis((params(3)+params(4))*[-1.1 , 1.1 , -0.1, 1.1] + [ 0, 0, 0,params()])
xlabel('x [m]','fontsize',12)
ylabel('y [m]','fontsize',12)


end
