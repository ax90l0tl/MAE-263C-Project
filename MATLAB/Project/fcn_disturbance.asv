% function tau = fcn_disturbance(t,X,p)
% 
% q = X(1:3);
Jt = 1;
magnitude = 2;
start_time = 0.5;
step_duration = 1;
t = 2;
if (start_time<=t) && (t<start_time+step_duration)
    tau = Jt * [0 , magnitude]';
elseif (2*start_time+step_duration<=t) && (t< 2*start_time + 2*step_duration)
    tau = Jt * [0 , -magnitude]';
else
    tau = [0 0]';
end

tau




% end
