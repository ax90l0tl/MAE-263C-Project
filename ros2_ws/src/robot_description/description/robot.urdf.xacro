<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="robot">
    <xacro:arg name="use_sim_time" default="false" />
    <xacro:arg name="torque_control" default="false" />
    <xacro:arg name="position_control" default="false" />
    <xacro:property name="L1_length" default="0.125" />
    <xacro:property name="L2_length" default="0.215" />
    <xacro:property name="max_torque" default="20.1" />
    <link name="world">
    </link>

    <!-- 
    ** IMPORTANT **
    Moment of inertia cross terms are zero for stability
    Moment of inertia of base_link not real because it doesn't rotate (helps sim stability)
    Moment of inertia xx and yy terms for hip, knee, and foot are set to 0.1 for stability
    -->
    <joint name="slider_joint" type="prismatic">
        <parent link="world" />
        <child link="base_link" />
        <origin xyz="0 0 1.0" rpy="0 0 0" />
        <axis xyz="0 0 1" />
        <limit effort="0" lower="-10.0" upper="10" velocity="100.0" />
        <dynamics damping="0.0" friction="0.0" />
    </joint>

    <link name="base_link">
        <visual>
            <geometry>
                <xacro:if value="$(arg use_sim_time)">
                    <mesh filename="file://$(find robot_description)/meshes/base_link.STL" />
                </xacro:if>
                <xacro:unless value="$(arg use_sim_time)">
                    <!-- for preview -->
                    <mesh filename="../meshes/base_link.STL" />
                    <!-- <box size="${L1_length} 0.05 0.02" /> -->
                </xacro:unless>
            </geometry>
            <material name="red">
                <color rgba="1 0 0 1" />
            </material>
        </visual>
        <inertial>
            <origin xyz="0.0 0 0" rpy="0 0 0" />
            <mass value="0.67115" />
            <inertia ixx="0.1" ixy="0.0" ixz="0.0"
                iyy="0.1" iyz="0.0" izz="0.1" />
        </inertial>
    </link>

    <joint name="hip_joint" type="revolute">
        <parent link="base_link" />
        <child link="hip_link" />
        <origin xyz="0 0 0" rpy="${pi/2} ${pi/2} 0" />
        <axis xyz="0 0 1" />
        <limit effort="${max_torque}" lower="-2.8" upper="0.46" velocity="31.67" />
        <dynamics damping="0.01" friction="0.01" />
    </joint>

    <link name="hip_link">
        <visual>
            <!-- <origin xyz="${L1_length/2} 0 0" rpy="0 0 0" /> -->
            <geometry>
                <xacro:if value="$(arg use_sim_time)">
                    <mesh filename="file://$(find robot_description)/meshes/hip.STL" />
                </xacro:if>
                <xacro:unless value="$(arg use_sim_time)">
                    <!-- for preview -->
                    <mesh filename="../meshes/hip.STL" />
                    <!-- <box size="${L1_length} 0.05 0.02" /> -->
                </xacro:unless>
            </geometry>
            <material name="blue">
                <color rgba="0 0 1 1" />
            </material>
        </visual>
        <collision>
            <geometry>
                <mesh filename="file://$(find robot_description)/meshes/hip_collision.STL" />
                <!-- for preview -->
                <!-- <mesh filename="../meshes/hip_collision.STL" /> -->
            </geometry>
        </collision>
        <inertial>
            <origin xyz="0.014130 0.059212 0.010598" rpy="0 0 0" />
            <mass value="0.482069" />
            <inertia ixx="0.01" ixy=" 0.0" ixz="0.0"
                iyy="0.01" iyz="0.0" izz="0.001186" />
        </inertial>
    </link>

    <joint name="knee_joint" type="revolute">
        <parent link="hip_link" />
        <child link="knee_link" />
        <origin xyz="${L1_length} 0 0.0277" rpy="0 0 0" />
        <axis xyz="0 0 1" />
        <limit effort="${max_torque}" lower="0.3" upper="2.62" velocity="31.67" />
        <dynamics damping="0.01" friction="0.01" />
    </joint>

    <link name="knee_link">
        <visual>
            <!-- <origin xyz="${L2_length/2} 0 0" rpy="0 0 0" /> -->
            <geometry>
                <xacro:if value="$(arg use_sim_time)">
                    <mesh filename="file://$(find robot_description)/meshes/knee.STL" />
                </xacro:if>
                <xacro:unless value="$(arg use_sim_time)">
                    <!-- for preview -->
                    <mesh filename="../meshes/knee.STL" />
                    <!-- <box size="${L2_length} 0.05 0.02" /> -->
                </xacro:unless>
            </geometry>
            <material name="green">
                <color rgba="0 1 0 1" />
            </material>
        </visual>
        <collision>
            <geometry>
                <mesh filename="file://$(find robot_description)/meshes/knee_collision.STL" />
                <!-- for preview -->
                <!-- <mesh filename="../meshes/knee_collision.STL" /> -->
            </geometry>
        </collision>
        <inertial>
            <origin xyz="0.117055 -0.019215 -0.000018" rpy="0 0 0" />
            <mass value="0.047151" />
            <inertia ixx="0.01" ixy="0.0" ixz="0.0"
                iyy="0.01" iyz="0.0" izz="0.000464" />
        </inertial>
    </link>

    <!-- This has to be a revolute joint for some dumb reason -->
    <!-- Can also change this manually in the sdf to a fixed joint -->
    <joint name="contact_joint" type="fixed">
        <!-- <joint name="contact_joint" type="revolute"> -->
        <parent link="knee_link" />
        <child link="foot_link" />
        <origin xyz="${L2_length} 0 0" rpy="0 0 0" />
        <axis xyz="0 0 1" />
        <limit effort="1e-5" lower="0" upper="0" velocity="1e-5" />
        <dynamics damping="0.0" friction="0.0" />
    </joint>

    <link name="foot_link">
        <visual>
            <geometry>
                <xacro:if value="$(arg use_sim_time)">
                    <mesh filename="file://$(find robot_description)/meshes/foot.STL" />
                </xacro:if>
                <xacro:unless value="$(arg use_sim_time)">
                    <!-- for preview -->
                    <mesh filename="../meshes/foot.STL" />
                    <!-- <sphere radius="0.05" /> -->
                </xacro:unless>
            </geometry>
            <material name="red">
                <color rgba="1 0 0 1" />
            </material>
        </visual>
        <!-- Something is wrong with the urdf/xacro/sdf conversion.
         This collision name changes when the sim is launched. -->
        <!-- <collision name="foot_collision"> -->
        <collision>
            <geometry>
                <sphere radius="0.02414" />
            </geometry>
        </collision>
        <inertial>
            <origin xyz="0.000290 -0.000906 -0.000052" rpy="0 0 0" />
            <mass value="0.013619" />
            <inertia ixx="0.01" ixy="0.0" ixz="0.0"
                iyy="0.01" iyz="0.0" izz="0.000004" />
        </inertial>
    </link>


    <xacro:if value="$(arg use_sim_time)">
        <xacro:include filename="$(find robot_description)/description/simulation.xacro" />
        <xacro:if value="$(arg torque_control)">
            <xacro:include filename="$(find robot_description)/description/torque_control.xacro" />
        </xacro:if>
        <xacro:if value="$(arg position_control)">
            <xacro:include filename="$(find robot_description)/description/position_control.xacro" />
        </xacro:if>
    </xacro:if>
</robot>