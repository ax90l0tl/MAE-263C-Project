<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="robot">
    <xacro:arg name="use_sim_time" default="false" />
    <xacro:arg name="torque_control" default="false" />
    <xacro:arg name="position_control" default="false" />
    <xacro:property name="L1_length" default="0.145" />
    <!-- <xacro:property name="L1_length" default="0.093732"/> -->
    <xacro:property name="L2_length" default="0.215" />
    <!-- <xacro:property name="L2_length" default="0.125"/> -->
    <xacro:property name="max_torque" default="20.1" />
    <link name="world">
    </link>

    <joint name="slider_joint" type="prismatic">
        <parent link="world" />
        <child link="base_link" />
        <origin xyz="0 0 1.0" rpy="0 0 0" />
        <axis xyz="0 0 1" />
        <limit effort="0" lower="-10" upper="10" velocity="100.0" />
        <dynamics damping="0.0" friction="0.0" />
    </joint>

    <link name="base_link">
        <visual>
            <geometry>
                <!-- <mesh filename="file://$(find robot_description)/meshes/base_link.stl"/> -->
                <!-- for preview -->
                <mesh filename="../meshes/base_link.STL" />
                <!-- <box size="${L1_length} 0.05 0.02" /> -->
            </geometry>
        </visual>
        <inertial>
            <origin xyz="0.000113 0.003536 0.005902" rpy="0 0 0" />
            <mass value="0.39" />
            <inertia ixx="0.000359" ixy="0.000001" ixz="-0.000001"
                iyy="0.000160" iyz="0.000076" izz="0.000302" />
        </inertial>
    </link>

    <joint name="hip_joint" type="revolute">
        <parent link="base_link" />
        <child link="hip_link" />
        <origin xyz="0 0 0" rpy="${pi/2} ${pi/2} 0" />
        <axis xyz="0 0 1" />
        <limit effort="${max_torque}" lower="-2.8" upper="0.46" velocity="31.67" />
        <dynamics damping="0.1" friction="0.1" />
    </joint>

    <link name="hip_link">
        <visual>
            <!-- <origin xyz="${L1_length/2} 0 0" rpy="0 0 0" /> -->
            <geometry>
                <!-- <mesh filename="file://$(find robot_description)/meshes/hip.stl"/> -->
                <!-- for preview -->
                <mesh filename="../meshes/hip.STL" />
                <!-- <box size="${L1_length} 0.05 0.02" /> -->
            </geometry>
            <material name="blue">
                <color rgba="0 0 1 1" />
            </material>
        </visual>
        <!-- <collision>
            <origin xyz="${L1_length/2} 0 0" rpy="0 0 0" /> -->
        <!-- <geometry>
                <box size="${L1_length} 0.05 0.02" /> -->
        <!-- </geometry> -->
        <!-- </collision> -->
        <inertial>
            <origin xyz="0.016172 0.057426 0.010825" rpy="0 0 0" />
            <mass value="0.5" />
            <inertia ixx="0.000596" ixy=" 0.000338" ixz="-0.000138"
                iyy="0.000959" iyz="0.000145" izz="0.001275" />
        </inertial>
    </link>

    <joint name="knee_joint" type="revolute">
        <parent link="hip_link" />
        <child link="knee_link" />
        <origin xyz="${L1_length} 0 0.0277" rpy="0 0 0" />
        <axis xyz="0 0 1" />
        <limit effort="${max_torque}" lower="-2.34" upper="2.62" velocity="31.67" />
        <dynamics damping="0.1" friction="0.1" />
    </joint>

    <link name="knee_link">
        <visual>
            <!-- <origin xyz="${L2_length/2} 0 0" rpy="0 0 0" /> -->
            <geometry>
                <!-- <mesh filename="file://$(find robot_description)/meshes/knee.STL"/> -->
                <!-- for preview -->
                <mesh filename="../meshes/knee.STL" />
                <!-- <box size="${L2_length} 0.05 0.02" /> -->
            </geometry>
            <material name="green">
                <color rgba="0 1 0 1" />
            </material>
        </visual>
        <!-- <collision> -->
        <!-- <origin xyz="${L2_length/2} 0 0" rpy="0 0 0" /> -->
        <!-- <geometry> -->
        <!-- <box size="${L2_length} 0.01 0.04" /> -->
        <!-- </geometry> -->
        <!-- </collision> -->
        <inertial>
            <origin xyz="0.119035 -0.021572 0.000043" rpy="0 0 0" />
            <mass value="0.055566" />
            <inertia ixx="0.000022" ixy="-0.000033" ixz="0.000000"
                iyy="0.000387" iyz="0.000000" izz="0.000407" />
        </inertial>
    </link>

    <!-- This has to be a revolute joint for some dumb reason -->
    <!-- Can also change this manually in the sdf to a fixed joint -->
    <joint name="contact_joint" type="fixed">
        <!-- <joint name="contact_joint" type="revolute"> -->
        <parent link="knee_link" />
        <child link="foot_link" />
        <origin xyz="${L2_length} 0 0" rpy="0 0 0" />
        <axis xyz="0 0 1" />
        <limit effort="1e-5" lower="0" upper="0" velocity="1e-5" />
        <dynamics damping="0.0" friction="0.0" />
    </joint>

    <link name="foot_link">
        <visual>
            <geometry>
                <!-- <mesh filename="file://$(find robot_description)/meshes/foot.stl"/> -->
                <!-- for preview -->
                <mesh filename="../meshes/foot.STL" />
                <!-- <sphere radius="0.05" /> -->
            </geometry>
        </visual>
        <!-- Something is wrong with the urdf/xacro/sdf conversion.
         This collision name changes when the sim is launched. -->
        <!-- <collision name="foot_collision"> -->
        <collision>
            <geometry>
                <cylinder radius="0.02414" length="0.01" />
            </geometry>
        </collision>
        <inertial>
            <origin xyz="0.000290 -0.000906 -0.000052" rpy="0 0 0" />
            <mass value="0.013619" />
            <inertia ixx="0.000002" ixy="0.000000" ixz="0.000000"
                iyy="0.000003" iyz="0.000000" izz="0.000004" />
        </inertial>
    </link>



    <xacro:if value="$(arg use_sim_time)">
        <xacro:include filename="$(find robot_description)/description/simulation.xacro" />
        <xacro:if value="$(arg torque_control)">
            <xacro:include filename="$(find robot_description)/description/torque_control.xacro" />
        </xacro:if>
        <xacro:if value="$(arg position_control)">
            <xacro:include filename="$(find robot_description)/description/position_control.xacro" />
        </xacro:if>
    </xacro:if>
</robot>